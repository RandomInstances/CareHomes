// carehomes.lk — data model
//
// Scope: Colombo district only (v2.0). `district` exists and defaults to
// "Colombo" so expansion is additive; the UI exposes `suburb`.
//
// CLINICAL DATA BOUNDARY (locked 29 Aug 2026):
// No assessment content ever enters this database. No ADLs, cognition scores,
// medications, diagnoses, falls risk, or clinical free-text. The nursing
// assessment stays with the Blanket Care clinician, is handed to the patient,
// and the patient shares it with the care home directly. This system records
// only WHICH homes were recommended and WHAT happened next.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// Prisma 7 no longer takes the connection URL here — it lives in
// prisma.config.ts, and the client is constructed with a driver adapter.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Reference data
// ---------------------------------------------------------------------------

/// Colombo suburbs drive both the filter UI and the SEO landing pages.
model Suburb {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  district  String   @default("Colombo")
  sortOrder Int      @default(0)
  homes     Home[]
  createdAt DateTime @default(now())

  @@index([district])
}

// ---------------------------------------------------------------------------
// Homes
// ---------------------------------------------------------------------------

model Home {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String @db.Text

  suburb   Suburb  @relation(fields: [suburbId], references: [id])
  suburbId String
  district String  @default("Colombo")
  address  String?
  lat      Float?
  lng      Float?

  // Fees are LKR per month. feeExcludes is what the fee does NOT cover —
  // families consistently report this as the thing they get caught out by.
  feeFrom     Int?
  feeTo       Int?
  feeExcludes String[] @default([])

  bedsTotal     Int?
  bedsAvailable Int?
  roomTypes     String[] @default([])

  /// What the home will take, and what it will not. Families filter on these so
  /// they stop ringing homes that were never going to accept the person, and
  /// homes stop fielding calls they always have to refuse.
  accepts     String[] @default([])
  notAccepted String[] @default([])
  minAge      Int?
  maxAge      Int?

  careTypes CareType[] @default([])
  features  String[]   @default([])
  languages Language[] @default([])

  nightNurses       Int?
  doctorArrangement String?
  transferHospital  String?
  visitingHours     String?

  phone    String?
  whatsapp String?
  email    String?

  status HomeStatus @default(PENDING_REVIEW)

  /// Unverified listings are free and self-serve. Verified means our team has
  /// visited and inspected the home; the home pays LKR 50,000 for that visit,
  /// which also covers the first twelve months listed.
  tier HomeTier @default(UNVERIFIED)

  /// Set when a field visit is completed and the tier becomes VERIFIED.
  verifiedAt DateTime?

  /// End of the paid listing period. Year one is bundled into the 50,000;
  /// LKR 1,000/month applies from year two.
  listingExpiresAt DateTime?

  /// Registered with the National Secretariat for Elders. Null = unknown.
  nseRegistered Boolean?

  /// Operated by Blanket Care. Disclosed in the UI — never used for ranking.
  isBlanketHome Boolean @default(false)

  /// Set when an owner claims the listing and keeps it current.
  ownerUpdatedAt DateTime?

  visits          Visit[]
  translations    HomeTranslation[]
  owners          HomeOwner[]
  edits           Edit[]
  recommendations Recommendation[]
  appointments    Appointment[]
  placements      Placement[]
  invoices        Invoice[]
  favourites      Favourite[]
  events          Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Verified homes rank ahead of unverified ones, so tier leads the ordering.
  @@index([status, tier, ownerUpdatedAt])
  @@index([status, suburbId])
}

/// Sinhala/Tamil localisation is a fast-follow, but the structure exists now —
/// retrofitting translations onto a single-language table means a rebuild.
model HomeTranslation {
  id          String  @id @default(cuid())
  home        Home    @relation(fields: [homeId], references: [id], onDelete: Cascade)
  homeId      String
  locale      Locale
  name        String?
  description String? @db.Text

  @@unique([homeId, locale])
}

/// First-party field visit. This structured, dated, photographed record is the
/// asset a scraper cannot replicate — and the basis of the factual badge.
/// Badge language is observational, never approving.
model Visit {
  id        String   @id @default(cuid())
  home      Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  homeId    String
  visitedOn DateTime
  officer   String

  nseRegistrationSighted   Boolean @default(false)
  nightRosterSeen          Boolean @default(false)
  doctorArrangementSighted Boolean @default(false)
  photographedByUs         Boolean @default(false)
  feeScheduleCollected     Boolean @default(false)

  /// Internal operational notes. Never rendered publicly.
  internalNotes String? @db.Text

  createdAt DateTime @default(now())

  @@index([homeId, visitedOn])
}

// ---------------------------------------------------------------------------
// Owners — claim by SMS OTP, edits go through review ("post validation")
// ---------------------------------------------------------------------------

/// Accounts are created by an admin during onboarding — every home is met in
/// person for a field visit, so there is no self-signup, no SMS gateway and no
/// email provider to depend on. Login is phone number + password.
model Owner {
  id     String      @id @default(cuid())
  name   String
  phone  String      @unique
  email  String?
  status OwnerStatus @default(PENDING)

  /// scrypt hash. Null until the admin issues credentials.
  passwordHash String?
  lastLoginAt  DateTime?

  homes     HomeOwner[]
  edits     Edit[]
  createdAt DateTime    @default(now())
}

model HomeOwner {
  home      Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  homeId    String
  owner     Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   String
  claimedAt DateTime @default(now())

  @@id([homeId, ownerId])
}

/// Owners never write to Home directly. Changes land here and an admin
/// approves them; approval applies the diff and stamps ownerUpdatedAt.
model Edit {
  id         String     @id @default(cuid())
  home       Home       @relation(fields: [homeId], references: [id], onDelete: Cascade)
  homeId     String
  owner      Owner?     @relation(fields: [ownerId], references: [id])
  ownerId    String?
  diff       Json
  status     EditStatus @default(PENDING)
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([status, createdAt])
}

model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([phone, expiresAt])
}

// ---------------------------------------------------------------------------
// Demand funnel
// ---------------------------------------------------------------------------

/// A family enquiry. Deliberately NON-CLINICAL — see the boundary note above.
/// careType and budgetBand are routing categories, not assessment output.
/// There is no free-text condition field: that box is how clinical detail
/// arrives whether or not you asked for it.
model Enquiry {
  /// Name and phone are OPTIONAL by design. Every call to action hands off to
  /// WhatsApp, so identity arrives in the clinician's inbox and never here.
  /// A typical record is "someone in Nugegoda, 78, budget 150k, two homes".
  id         String  @id @default(cuid())
  familyName String?
  phone      String?
  whatsapp   String?
  email      String?

  preferredSuburbs String[]    @default([])
  careType         CareType?
  budgetBand       BudgetBand?
  timeframe        Timeframe?

  status EnquiryStatus @default(NEW)
  source String?

  recommendations Recommendation[]
  appointments    Appointment[]
  placement       Placement?
  invoices        Invoice[]
  events          Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

/// Which homes were recommended. Records the OUTCOME of the assessment,
/// never its content. Selection is on clinical fit against published criteria;
/// Blanket homes enter by the same criteria as every other home.
model Recommendation {
  id        String   @id @default(cuid())
  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  enquiryId String
  home      Home     @relation(fields: [homeId], references: [id])
  homeId    String
  rank      Int
  createdAt DateTime @default(now())

  @@unique([enquiryId, homeId])
}

/// A visit we arrange for a family. Homes are NOT billed for these — families
/// pay the placement fee, so there is no per-visit charge and no pay-to-reveal.
model Appointment {
  id           String            @id @default(cuid())
  enquiry      Enquiry           @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  enquiryId    String
  home         Home              @relation(fields: [homeId], references: [id])
  homeId       String
  scheduledFor DateTime?
  status       AppointmentStatus @default(PROPOSED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, scheduledFor])
}

/// A completed placement. Records where a family was actually placed — the outcome
/// measure for the funnel, and the basis of conversion reporting.
model Placement {
  id        String          @id @default(cuid())
  enquiry   Enquiry         @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  enquiryId String          @unique
  home      Home            @relation(fields: [homeId], references: [id])
  homeId    String
  status    PlacementStatus @default(IN_PROGRESS)
  movedInAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, movedInAt])
}

/// Issued and reconciled by hand (bank transfer), except the family deposit,
/// which will move to PAYable. A tracker for the ops console, not a gateway.
///
/// Payer is a home (verification, renewal) or an enquiry (deposit, balance) —
/// exactly one of homeId / enquiryId is set, enforced in application code
/// since Prisma cannot express the constraint.
model Invoice {
  id   String      @id @default(cuid())
  kind InvoiceKind

  home      Home?    @relation(fields: [homeId], references: [id])
  homeId    String?
  enquiry   Enquiry? @relation(fields: [enquiryId], references: [id])
  enquiryId String?

  amountLkr       Int
  reference       String        @unique
  status          InvoiceStatus @default(ISSUED)
  issuedAt        DateTime      @default(now())
  paidConfirmedAt DateTime?

  /// Listing period covered, for verification and renewal invoices.
  periodStart DateTime?
  periodEnd   DateTime?

  /// Set when this invoice is a credit note or refund against another.
  creditForInvoiceId String?

  @@index([status, issuedAt])
  @@index([kind, status])
}

// ---------------------------------------------------------------------------
// Attribution — live from day one, so month 9 is a pricing switch, not a rebuild
// ---------------------------------------------------------------------------

model Event {
  id        String    @id @default(cuid())
  type      EventType
  home      Home?     @relation(fields: [homeId], references: [id])
  homeId    String?
  enquiry   Enquiry?  @relation(fields: [enquiryId], references: [id])
  enquiryId String?

  /// Anonymous browser session, so pre-enquiry behaviour can be joined later.
  sessionId String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([homeId, type, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}


// ---------------------------------------------------------------------------
// Visitor accounts — saving favourites, comparing, and opting in to updates
// ---------------------------------------------------------------------------

/// A family member using the site. Distinct from Owner, which is a care home
/// operator, and from the single admin account.
model User {
  id    String  @id @default(cuid())
  name  String
  email String  @unique
  phone String?

  /// Set when the account came from Google, so we know the address is verified
  /// by them rather than by us.
  googleId      String?   @unique
  emailVerified DateTime?

  /// Marketing consent is separate from having an account, and separately
  /// revocable. Never pre-ticked, and never bundled into signing up.
  marketingOptIn   Boolean   @default(false)
  marketingOptInAt DateTime?

  favourites Favourite[]
  createdAt  DateTime    @default(now())
  lastSeenAt DateTime    @default(now())

  @@index([email])
}

/// A saved home. Kept server-side so it follows the person between devices —
/// which is the whole reason to have an account.
model Favourite {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  home   Home   @relation(fields: [homeId], references: [id], onDelete: Cascade)
  homeId String

  /// Private to the person who saved it; never shown to the home.
  note String?

  createdAt DateTime @default(now())

  @@unique([userId, homeId])
  @@index([userId, createdAt])
}

/// Single-use sign-in link. Hashed, short-lived, and deleted once spent.
model LoginToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  name      String?
  /// Carried through the link so the opt-in the person actually ticked is the
  /// one recorded, rather than being lost between the form and the account.
  marketingOptIn Boolean @default(false)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email, expiresAt])
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Four categories, deliberately few. Respite, dementia and palliative folded
/// into admission criteria, where "will you take this person" is a better
/// question than "which of six labels applies".
enum CareType {
  ELDER_HOME
  NURSING_HOME
  REHAB
}

enum Language {
  SINHALA
  TAMIL
  ENGLISH
}

enum Locale {
  EN
  SI
  TA
}

enum HomeStatus {
  DRAFT
  PENDING_REVIEW
  LIVE
  SUSPENDED
}

/// Unverified = free self-serve listing. Verified = we visited and inspected it,
/// which the home paid LKR 50,000 for. Verified ranks first.
enum HomeTier {
  UNVERIFIED
  VERIFIED
}

enum OwnerStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum EditStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BudgetBand {
  UNDER_75K
  BAND_75_150K
  BAND_150_250K
  OVER_250K
}

enum Timeframe {
  IMMEDIATE
  WITHIN_1_MONTH
  WITHIN_3_MONTHS
  EXPLORING
}

enum EnquiryStatus {
  NEW
  TRIAGED
  ASSESSED
  PROFILE_SENT
  HOME_ACCEPTED
  BOOKED
  ATTENDED
  MOVED_IN
  CLOSED
}

/// No INVOICED state: homes are not billed per visit under the current model.
enum AppointmentStatus {
  PROPOSED
  CONFIRMED
  ATTENDED
  NO_SHOW
  CANCELLED
}

enum PlacementStatus {
  IN_PROGRESS
  PLACED
  CANCELLED
}

/// Home-side: verification (LKR 50,000, includes year one) and annual renewal
/// (LKR 1,000/month from year two). Family-side: the LKR 25,000 deposit and the
/// LKR 25,000 balance due on placement.
enum InvoiceKind {
  HOME_VERIFICATION
  HOME_RENEWAL
  FAMILY_DEPOSIT
  FAMILY_BALANCE
}

enum InvoiceStatus {
  ISSUED
  PAID
  CREDITED
  VOID
}

enum EventType {
  LISTING_VIEW
  SEARCH
  FILTER_APPLIED
  SHORTLIST_ADD
  COMPARE_VIEW
  CALL_INTENT
  WHATSAPP_CLICK
  ENQUIRY_SUBMITTED
  TRIAGED
  ASSESSED
  PROFILE_SENT
  HOME_ACCEPTED
  APPOINTMENT_BOOKED
  APPOINTMENT_ATTENDED
  APPOINTMENT_NO_SHOW
  MOVED_IN
}
